{
  "expo": {
    "name": "Field Force",
    "slug": "Field-Force",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/ff.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./src/assets/images/mobile.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090b"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.teamdev.merchandisingteam",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/login.png",
        "backgroundColor": "#09090b"
      },
      "package": "com.teamdev.merchandisingteam",
      "usesCleartextTraffic": true
    },
    "web": {
      "favicon": "./src/assets/images/web.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./src/assets/images/notification-icon.png",
          "color": "#ffffff",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them with your supervisor.",
          "cameraPermission": "The app accesses your camera to let you take photos of store anomalies."
        }
      ]
    ],
    "scheme": "merchandisingteam",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "your-project-id"
      }
    }
  }
}